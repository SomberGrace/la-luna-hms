# =============================================================================
# La Luna Hotel Management System - Backend Database Configuration
# =============================================================================

# Server Port
PORT=8080

# Supabase / PostgreSQL Connection URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Or Local Docker: postgresql://postgres:admin@localhost:5432/la-luna-db?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/la-luna-db?sslmode=disable

# Supabase Direct Config (Optional)
SUPABASE_URL=https://vvxkhrdginpmwpwghtuf.supabase.co
SUPABASE_ANON_KEY=sb_publishable_O6fh26bCYE97cgdQuKXTsw_zAXkHlN1
SUPABASE_JWKS_URL=https://vvxkhrdginpmwpwghtuf.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database connection pool and local startup behavior
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m
RUN_STARTUP_MIGRATIONS=true
SEED_DATABASE=true
